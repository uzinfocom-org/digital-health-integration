CodeSystem: DonationCompensationCS
Id: donation-compensation-cs
Title: "Donation compensation codes"
Description: "Donation compensation types in Uzbekistan"
* insert OriginalCodeSystemDraft(donation-compensation-cs)

* #bdcomp-0001-00001 "Bepul"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Безвозмездный"
  * ^designation[+].language = #en
  * ^designation[=].value = "Unpaid"

* #bdcomp-0001-00002 "Pullik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Возмездный"
  * ^designation[+].language = #en
  * ^designation[=].value = "Paid"
