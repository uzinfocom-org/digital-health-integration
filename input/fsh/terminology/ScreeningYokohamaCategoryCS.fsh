CodeSystem: ScreeningYokohamaCategoryCS
Id: screening-yokohama-category-cs
Title: "Screening Yokohama Category CodeSystem"
Description: "Yokohama system categories for breast fine-needle aspiration cytology."
* insert OriginalCodeSystemDraft(screening-yokohama-category-cs)

* #scrn-0084-00001 "C1 — material yetarli emas"
  * ^designation[0].language = #ru
  * ^designation[=].value = "C1 — материал недостаточен"
  * ^designation[+].language = #en
  * ^designation[=].value = "C1 — insufficient material"
* #scrn-0084-00002 "C2 — yaxshi sifatli jarayon"
  * ^designation[0].language = #ru
  * ^designation[=].value = "C2 — доброкачественный процесс"
  * ^designation[+].language = #en
  * ^designation[=].value = "C2 — benign"
* #scrn-0084-00003 "C3 — aniqlanmagan ahamiyatli atipiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "C3 — атипия неопределённого значения"
  * ^designation[+].language = #en
  * ^designation[=].value = "C3 — atypical, indeterminate"
* #scrn-0084-00004 "C4 — yomon sifatli o‘smaga shubha"
  * ^designation[0].language = #ru
  * ^designation[=].value = "C4 — подозрение на злокачественное новообразование"
  * ^designation[+].language = #en
  * ^designation[=].value = "C4 — suspicious for malignancy"
* #scrn-0084-00005 "C5 — yomon sifatli o‘sma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "C5 — злокачественное новообразование"
  * ^designation[+].language = #en
  * ^designation[=].value = "C5 — malignant"
