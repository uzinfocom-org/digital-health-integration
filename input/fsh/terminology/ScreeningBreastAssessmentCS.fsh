CodeSystem: ScreeningBreastAssessmentCS
Id: screening-breast-assessment-cs
Title: "Screening Breast Assessment CodeSystem"
Description: "CodeSystem for Screening Breast Assessment"
* insert OriginalCodeSystemDraft(screening-breast-assessment-cs)

* #scrn-0014-00001 "Sut bezlari atrofiyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Атрофия молочных желез"
  * ^designation[+].language = #en
  * ^designation[=].value = "Breast atrophy"

* #scrn-0014-00002 "Ko‘krak bezi giperplaziyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гиперплазия молочных желез"
  * ^designation[+].language = #en
  * ^designation[=].value = "Breast hyperplasia"

* #scrn-0014-00003 "Ko‘krak bezi gipoplaziyasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Гипоплазия молочных желез"
  * ^designation[+].language = #en
  * ^designation[=].value = "Breast hypoplasia"
