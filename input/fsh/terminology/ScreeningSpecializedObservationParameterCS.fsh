CodeSystem: ScreeningSpecializedObservationParameterCS
Id: screening-specialized-observation-parameter-cs
Title: "Screening Specialized Observation Parameter CodeSystem"
Description: "Local codes for component parameters that are not represented in the ultrasound parameter code system."
* insert OriginalCodeSystemDraft(screening-specialized-observation-parameter-cs)

* #breast-finding "Ko‘krak bezidagi topilma"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Находка в молочной железе"
  * ^designation[+].language = #en
  * ^designation[=].value = "Breast finding"

* #breast-histology-result "Ko‘krak bezi gistologiyasi natijasi"
