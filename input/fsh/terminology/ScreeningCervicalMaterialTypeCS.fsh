CodeSystem: ScreeningCervicalMaterialTypeCS
Id: screening-cervical-material-type-cs
Title: "Screening Cervical Material Type CodeSystem"
Description: "CodeSystem for Screening Cervical Material Type"
* insert OriginalCodeSystemDraft(screening-cervical-material-type-cs)

* #scrn-0037-00001 "Punksion biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Пункционная биопсия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Punch biopsy"

* #scrn-0037-00002 "Konizatsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Конизация"
  * ^designation[+].language = #en
  * ^designation[=].value = "Conization"

* #scrn-0037-00003 "Endoservikal kyuretaj-biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Эндоцервикальный кюретаж-биопсия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Endocervical curettage biopsy"

* #scrn-0037-00004 "Eksizion biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Эксцизионная биопсия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Excisional biopsy"

* #scrn-0037-00005 "Kyuretaj bilan eksizion biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Эксцизионная биопсия с кюретажом"
  * ^designation[+].language = #en
  * ^designation[=].value = "Excisional biopsy with curettage"

* #scrn-0037-00006 "Konussimon biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Конусовидная биопсия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cone biopsy"

* #scrn-0037-00007 "Kyuretaj bilan konussimon biopsiya"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Конусовидная биопсия с кюретажом"
  * ^designation[+].language = #en
  * ^designation[=].value = "Cone biopsy with curettage"
