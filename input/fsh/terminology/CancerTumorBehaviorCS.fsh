Description: "Cancer tumor behavior code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-tumor-behavior-cs)

* #cancer-0019-0001 "Yaxshi sifatli"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Доброкачественная"
  * ^designation[+].language = #en
  * ^designation[=].value = "Benign"

* #cancer-0019-0002 "Noaniq xulqli"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Неопределенная"
  * ^designation[+].language = #en
  * ^designation[=].value = "Uncertain behavior"

* #cancer-0019-0003 "In situ"
  * ^designation[0].language = #ru
  * ^designation[=].value = "In situ"
  * ^designation[+].language = #en
  * ^designation[=].value = "In situ"

* #cancer-0019-0004 "Yomon sifatli"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Злокачественная"
  * ^designation[+].language = #en
  * ^designation[=].value = "Malignant"