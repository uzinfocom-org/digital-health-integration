CodeSystem: Form097LoincSupplementCS
Id: form-097-loinc-supplement-cs
Title: "Form 097 LOINC Displays"
Description: "Uzbek and Russian displays for the LOINC codes used in Form 097"

* insert SupplementCodeSystemDraft(form-097-loinc-supplement-cs, $loinc, 2.82.0)

* #10206-1 "Physical findings of Skin Narrative"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Кожа"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Teri"

* #10197-2 "Physical findings of Eye Narrative"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Глаза, слизистые оболочки"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Ko'zlar, shilliq qavatlar"

* #11412-4 "Physical findings of Respiratory system Narrative"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Дыхательная недостаточность"
  * ^designation[+].language = #uz
  * ^designation[=].value = "Nafas yetishmovchiligi"
