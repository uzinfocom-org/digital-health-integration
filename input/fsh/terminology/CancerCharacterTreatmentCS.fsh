CodeSystem: CancerCharacterTreatmentCS
Id: cancer-character-treatment-cs
Title: "Cancer character of treatment translation in Russian and English"
Description: "Cancer character of treatment code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-character-treatment-cs)

* #cancer-0017-0001 "O‘tkazilmagan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Не проводилось"
  * ^designation[+].language = #en
  * ^designation[=].value = "Not performed"

* #cancer-0017-0002 "Radikal"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Радикальное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Radical"

* #cancer-0017-0003 "Palliativ"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Паллиативное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Palliative"

* #cancer-0017-0004 "Simptomatik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Симптоматическое"
  * ^designation[+].language = #en
  * ^designation[=].value = "Symptomatic"

* #cancer-0017-0005 "Reabilitatsion"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Реабилитационное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Rehabilitative"

* #cancer-0017-0006 "Tugallanmagan radikal"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Радикальное незавершенное"
  * ^designation[+].language = #en
  * ^designation[=].value = "Incomplete radical treatment"

* #cancer-0017-0007 "Profilaktik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Профилактическое"
  * ^designation[+].language = #en
