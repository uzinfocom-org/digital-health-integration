CodeSystem: Form044TravelClearanceConclusionCS
Id: form-044-travel-clearance-conclusion-cs
Title: "Form 044 Travel Clearance Conclusion"
Description: "Local codes for the medical conclusion on whether a patient has contraindications to travel abroad."
* insert OriginalCodeSystemDraft(form-044-travel-clearance-conclusion-cs)

* #form-0044-0001 "Mumkin"
  * ^designation[0].language = #en
  * ^designation[=].value = "Allowed"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Разрешено"

* #form-0044-0002 "Mumkin emas"
  * ^designation[0].language = #en
  * ^designation[=].value = "Denied"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Не разрешено"