CodeSystem: ScreeningPregnancyOutcomeCS
Id: screening-pregnancy-outcome-cs
Title: "Screening Pregnancy Outcome CodeSystem"
Description: "CodeSystem for Screening Pregnancy Outcome"
* insert OriginalCodeSystemDraft(screening-pregnancy-outcome-cs)

* #scrn-0006-00001 "Muddatidan oldin tug‘ruq"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Преждевременные роды"
  * ^designation[+].language = #en
  * ^designation[=].value = "Preterm labor"

* #scrn-0006-00002 "Bachadondan tashqari homiladorlik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Внематочная беременность"
  * ^designation[+].language = #en
  * ^designation[=].value = "Ectopic pregnancy"

* #scrn-0006-00003 "To‘xtab qolgan homiladorlik"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Замершая беременность"
  * ^designation[+].language = #en
  * ^designation[=].value = "Fetal death"

* #scrn-0006-00004 "Tibbiy abort"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Медицинский аборт"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical abortion"

* #scrn-0006-00005 "Tibbiy ko‘rsatmalar bo‘yicha uzilish"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Прерывание по медпоказаниям"
  * ^designation[+].language = #en
  * ^designation[=].value = "Termination for medical indications"

* #scrn-0006-00006 "O‘z-o‘zidan homila tushishi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Самопроизвольный выкидыш"
  * ^designation[+].language = #en
  * ^designation[=].value = "Spontaneous abortion"
