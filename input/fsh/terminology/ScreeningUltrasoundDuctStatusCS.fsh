Title: "Screening Ultrasound Duct Status CodeSystem"
Description: "CodeSystem for Screening Ultrasound Duct Status"
* insert OriginalCodeSystemDraft(screening-ultrasound-duct-status-cs)

* #scrn-0044-00001 "Kengaymagan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Не расширены"
  * ^designation[+].language = #en
  * ^designation[=].value = "Not dilated"

* #scrn-0044-00002 "Bir tekis kengaygan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Расширены равномерно"
  * ^designation[+].language = #en
  * ^designation[=].value = "Uniformly dilated"

* #scrn-0044-00003 "Mahalliy kengaygan (duktektaziya)"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Локально расширены (дуктэктазия)"
  * ^designation[+].language = #en
  * ^designation[=].value = "Locally dilated (ductectasia)"

* #scrn-0044-00004 "Devor bo‘ylab o‘simtalar bilan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "С пристеночными разрастаниями"
  * ^designation[+].language = #en
  * ^designation[=].value = "With mural growths"
  
* #scrn-0044-00005 "Zich tarkib bilan"
  * ^designation[0].language = #ru
  * ^designation[=].value = "С густым содержимым"
  * ^designation[+].language = #en
  * ^designation[=].value = "With dense content"
