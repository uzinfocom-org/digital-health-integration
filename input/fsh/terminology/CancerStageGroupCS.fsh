  * ^designation[+].language = #en
  * ^designation[=].value = "Pathologic TNM stage grouping"

* #cancer-0021-0004 "Bosqich"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Стадия"
  * ^designation[+].language = #en
  * ^designation[=].value = "Stage"

* #cancer-0021-0005 "Bosqichni aniqlashtirish"
