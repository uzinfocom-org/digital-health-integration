CodeSystem: CancerStageGroupCS
Id: cancer-stage-group-cs
Title: "Cancer stage group translation in Russian and English"
Description: "Cancer stage group code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-stage-group-cs)

* #cancer-0021-0001 "TNM bosqichlarini guruhlash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Группировка стадий TNM"
  * ^designation[+].language = #en
  * ^designation[=].value = "TNM stage grouping"

* #cancer-0021-0002 "Klinik TNM bosqichlarini guruhlash"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Клиническая группировка стадий TNM"
  * ^designation[+].language = #en
  * ^designation[=].value = "Clinical TNM stage grouping"

