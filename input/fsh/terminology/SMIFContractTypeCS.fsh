CodeSystem: SMIFContractTypeCS
Id: smif-contract-type-cs
Title: "SMIF Contract Types"
Description: "Types of contracts between the State Medical Insurance Fund and organizations"
* insert OriginalCodeSystemDraft(smif-contract-type-cs)
* #medical-service "Tibbiy xizmatlar shartnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Договор на оказание медицинских услуг"
  * ^designation[+].language = #en
  * ^designation[=].value = "Medical service delivery contract"
* #pharmacy-reimbursement "Dori vositalarini kompensatsiya qilish shartnomasi"
  * ^designation[0].language = #ru
  * ^designation[=].value = "Договор на реимбурсацию лекарственных средств"
  * ^designation[+].language = #en
  * ^designation[=].value = "Pharmacy reimbursement contract"
