CodeSystem: CancerTNMCategoryCS
Id: cancer-tnm-category-cs
Title: "Cancer TNM category translation in Russian and English"
Description: "Cancer TNM category code system for Uzbekistan healthcare system"
* insert OriginalCodeSystemDraft(cancer-tnm-category-cs)

* #cancer-0022-0001 "cM category"
  * ^designation[0].language = #ru
  * ^designation[=].value = "cM категория"
  * ^designation[+].language = #en
  * ^designation[=].value = "cM category"

