  * ^designation[+].language = #ru
  * ^designation[=].value = "Бимануальное исследование матки и придатков"

* #chr-0017-00002 "Patologik o'zgarishlar"
  * ^designation[0].language = #en
  * ^designation[=].value = "Pathological changes"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Патологические изменения"

* #chr-0017-00003 "Ginekologik ko'rikning o'ziga xos xususiyatlari"
  * ^designation[0].language = #en
  * ^designation[=].value = "Special gynecological findings"
  * ^designation[+].language = #ru
  * ^designation[=].value = "Особенности гинекологического осмотра"

* #chr-0017-00004 "Tuxumdon va naychalar ko'rigi"
  * ^designation[0].language = #en
  * ^designation[=].value = "Examination of ovaries and fallopian tubes"
  * ^designation[+].language = #ru
