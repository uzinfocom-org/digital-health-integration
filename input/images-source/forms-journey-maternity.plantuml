@startuml forms-journey-maternity
title Sample journey - pregnancy, birth and the newborn (volumes 2, 6, 1)
autonumber

actor "Pregnant\nwoman" as W
participant "Family polyclinic\n(vol 2)" as PC
participant "Screening centre\n(vol 6)" as SC
participant "Maternity hospital\n(vol 1)" as MH

W -> PC : registers pregnancy
PC -> PC : opens 111 pregnant-woman individual card
PC -> SC : 037 prenatal screening referral / exchange sheet
SC -> SC : 159 prenatal exam card\n162-164 trimester ultrasound protocols\n156-157 biochemical screening conclusions

alt screening flags risk
  SC -> SC : 152/166 invasive prenatal diagnosis,\n154 cytogenetic result, 165 genetic conclusion
end

W -> MH : admitted for delivery
MH -> MH : 096 maternity card\n010 birth register
MH -> MH : 097 newborn development card\n103 birth certificate registration
MH -> SC : heel-prick sample
SC -> SC : 167-171 neonatal screening (IRT, PKU, CH)

alt adverse outcome
  MH -> MH : 003-1 early termination /\n106-2 perinatal death certificate
  MH -> PC : 114 congenital-anomaly notification
end
@enduml
