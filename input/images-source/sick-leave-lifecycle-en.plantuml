@startuml sick-leave-lifecycle-en
hide empty description
skinparam state {
  FontStyle bold
  RoundCorner 20
}
title Sick leave lifecycle

state "opened" as opened #DCFCE7;line:16A34A;line.bold;text:166534 : CarePlan.status = active
state "extended" as extended #DBEAFE;line:2563EB;line.bold;text:1E40AF : CarePlan.status = active
state "closed" as closed #E5E7EB;line:4B5563;line.bold;text:1F2937 : CarePlan.status = completed
state "cancelled" as cancelled #FEE2E2;line:DC2626;line.bold;text:991B1B : CarePlan.status = revoked

[*] --> opened : issued
opened --> extended : extended
extended --> extended : extended again
opened --> closed : closed
extended --> closed : closed
opened --> cancelled : cancelled
closed --> [*]
cancelled --> [*]

caption Each state is the workflowStatus extension; CarePlan.status is shown underneath.
@enduml
